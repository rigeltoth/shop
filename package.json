{
    "name": "shop",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev:server": "nodemon --watch 'src/**/*.ts' --exec ts-node ./src/index.ts",
        "dev:worker": "ts-node ./src/index-worker.ts",
        "dev": "concurrently \"bun run dev:server\" \"bun run dev:worker\"",
        "build:server": "tsc",
        "build:dashboard": "node scripts/patch-base-ui.mjs && node scripts/patch-empty-states.mjs && node scripts/patch-seller-labels.mjs && node scripts/patch-option-value-input.mjs && node scripts/patch-money-input.mjs && vite build && node scripts/copy-favicons.mjs",
        "build": "bun run build:server && bun run build:dashboard",
        "build:seed": "tsc && cp -R ./static ./dist/static",
        "start:server": "node ./dist/index.js",
        "start:worker": "node ./dist/index-worker.js",
        "start": "concurrently \"bun run start:server\" \"bun run start:worker\"",
        "seed:prod": "node ./dist/populate/seed.js",
        "seed:dev": "ts-node ./src/populate/seed.ts",
        "migrate": "ts-node ./src/migrate.ts",
        "delete:seller": "ts-node --transpile-only ./scripts/delete-unverified-seller.ts",
        "repair:invoice-schema": "ts-node --transpile-only ./scripts/repair-invoice-schema.ts",
        "repair:store-schema": "node ./scripts/repair-store-schema.mjs",
        "predev": "node ./scripts/repair-store-schema.mjs"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.908.0",
        "@aws-sdk/lib-storage": "3.908.0",
        "@clerk/backend": "^2.29.3",
        "@clerk/clerk-react": "^5.59.5",
        "@hookform/resolvers": "^5.2.2",
        "@lingui/react": "^5.9.0",
        "@pinelab/vendure-plugin-coinbase": "^1.5.0",
        "@pinelab/vendure-plugin-google-sheet-loader": "^1.0.2",
        "@pinelab/vendure-plugin-metrics": "^3.1.0",
        "@tanstack/react-query": "^5.95.2",
        "@tanstack/react-table": "^8.21.3",
        "@types/node": "^26.0.1",
        "@vendure/admin-ui-plugin": "3.7.2",
        "@vendure/asset-server-plugin": "3.7.2",
        "@vendure/core": "3.7.2",
        "@vendure/create": "3.7.2",
        "@vendure/dashboard": "3.7.2",
        "@vendure/email-plugin": "3.7.2",
        "@vendure/graphiql-plugin": "3.7.2",
        "axios": "^1.12.2",
        "crypto": "^1.0.1",
        "dotenv": "17.2.1",
        "google-auth-library": "^10.5.0",
        "jsonwebtoken": "^9.0.2",
        "jspdf": "^2.5.2",
        "jspdf-autotable": "^3.5.29",
        "jwks-rsa": "^3.2.0",
        "lucide-react": "^0.563.0",
        "modern-screenshot": "^4.7.0",
        "p-limit": "^3.1.0",
        "pg": "8.16.3",
        "react-hook-form": "^7.71.1",
        "react-is": "^19.2.7",
        "recharts": "^3.8.1",
        "resend": "^6.0.2",
        "sonner": "^2.0.7",
        "xlsx": "^0.18.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@angular/platform-browser-dynamic": "19.2.21",
        "@types/react": "19.2.9",
        "@vendure/cli": "3.7.2",
        "@vendure/ui-devkit": "3.7.2",
        "concurrently": "^9.2.0",
        "nodemon": "^3.1.11",
        "typescript": "5.8.3",
        "vite": "^7.3.1"
    },
    "overrides": {
        "@swc/core": "1.13.5",
        "@lingui/swc-plugin": "5.6.1"
    },
    "resolutions": {
        "@pinelab/vendure-plugin-metrics@^3.1.0": "patch:@pinelab/vendure-plugin-metrics@npm%3A3.1.0#./.yarn/patches/@pinelab-vendure-plugin-metrics-npm-3.1.0-7759b29dbb.patch"
    }
}
